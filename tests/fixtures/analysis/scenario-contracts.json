    {
      "id": "audience-and-leaderboard",
      "sections": ["material_leaderboard", "audience"],
      "resultStatus": "fixture_only",
      "requiredClaimTypes": ["fact"],
      "audienceCausalityGuard": "association_only"
    },
    {
      "id": "all-sections",
      "sections": ["material_leaderboard", "audience", "scripts", "highlight_frames"],
      "resultStatus": "fixture_only",
      "requiredClaimTypes": ["fact", "calculation", "inference"],
      "requiresTranscriptEvidence": true,
      "requiresJpegArtifactEvidence": true
    }
  ]
}
