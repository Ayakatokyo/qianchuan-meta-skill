{
  "schemaVersion": 1,
  "purpose": "Versioned compact contracts for the three real Top6 offline analysis scenarios.",
  "scenarios": [
    {
      "id": "leaderboard-only",
      "sections": ["material_leaderboard"],
      "resultStatus": "fixture_only",
      "requiredClaimTypes": ["fact"]
